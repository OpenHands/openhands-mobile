{
  "name": "@openhands/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Phone and tablet client for OpenHands",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenHands/openhands-mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
